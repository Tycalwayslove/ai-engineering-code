{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-code.local/contracts/workflow/workflow-manifest.schema.json",
  "title": "WorkflowManifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "owner",
    "trigger",
    "execution",
    "discovery",
    "source",
    "inputs",
    "outputs",
    "states",
    "memoryDomains",
    "humanReviewRequired"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "owner": { "type": "string" },
    "trigger": { "type": "string" },
    "execution": { "type": "string" },
    "discovery": { "type": "string" },
    "source": { "type": "string" },
    "inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "states": {
      "type": "array",
      "items": { "type": "string" }
    },
    "memoryDomains": {
      "type": "array",
      "items": { "type": "string" }
    },
    "humanReviewRequired": { "type": "boolean" }
  },
  "additionalProperties": false
}
