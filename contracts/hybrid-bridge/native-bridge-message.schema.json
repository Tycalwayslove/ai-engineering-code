{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-code.local/contracts/hybrid-bridge/native-bridge-message.schema.json",
  "title": "Native Bridge Message",
  "type": "object",
  "required": ["id", "type", "sentAt"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "h5.ready",
        "ui.openTimeline",
        "ui.openCalendar",
        "ui.openExecutionLedger",
        "input.voice.start",
        "input.voice.stop",
        "calendar.events.sync",
        "notifications.reminders.sync",
        "input.keyboard.open",
        "native.hostContext",
        "native.viewChanged",
        "native.inputRequested",
        "native.inputSubmitted",
        "native.themeChanged",
        "native.ack",
        "native.error"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "replyTo": {
      "type": "string"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "calendar.events.sync"
          }
        }
      },
      "then": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["events"],
            "additionalProperties": true,
            "properties": {
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "title",
                    "startAt",
                    "endAt",
                    "timezone",
                    "status",
                    "sourceActionId"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "endAt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceActionId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "startAt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "string",
                      "minLength": 1
                    },
                    "timezone": {
                      "type": "string",
                      "minLength": 1
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "notifications.reminders.sync"
          }
        }
      },
      "then": {
        "required": ["payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["reminders"],
            "additionalProperties": true,
            "properties": {
              "reminders": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "title", "dueAt", "status"],
                  "additionalProperties": true,
                  "properties": {
                    "dueAt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "string",
                      "minLength": 1
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
