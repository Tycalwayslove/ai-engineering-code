{
  "id": "component-library-maintenance",
  "name": "组件库维护",
  "owner": "current-task-owner",
  "trigger": "human",
  "execution": "manual",
  "discovery": "explicit-input-only",
  "source": "figma-markdown-codebase",
  "inputs": [
    "change type",
    "change target",
    "change reason",
    "impact scope",
    "acceptance criteria"
  ],
  "outputs": [
    "workflow run record",
    "design system revision",
    "shared-ui changes",
    "figma gallery or changelog updates",
    "verification record",
    "knowledge sync"
  ],
  "states": [
    "not_started",
    "context_loaded",
    "change_classified",
    "impact_mapped",
    "spec_or_fix_plan_drafted",
    "in_progress",
    "verified",
    "synced",
    "archived"
  ],
  "memoryDomains": [
    "durable/design",
    "durable/architecture",
    "working/active-context",
    "working/tasks",
    "working/iterations"
  ],
  "humanReviewRequired": true
}
